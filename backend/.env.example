# Server configuration
HOST=127.0.0.1
PORT=5000
NODE_ENV=development
# Keep the backend on loopback. The app trusts forwarded protocol metadata only
# from a 127.0.0.1 peer when this is true. The same-host proxy must overwrite
# X-Forwarded-Proto and X-Forwarded-Host, and forward only to 127.0.0.1:5000.
# This setting does not verify that external TLS is actually terminated.
LUMINICENT_TRUSTED_TLS_PROXY=false
# Compose-only exception: Compose sets both flags and publishes the backend on 127.0.0.1.
LUMINICENT_LOCAL_ONLY=false
LUMINICENT_COMPOSE_LOCAL_ONLY=false
# Project builds are disabled. The API has no isolated scan worker and does not
# fall back to running project builds in the API process.
LUMINICENT_EXECUTION_MODE=disabled
# Reserved for the disabled Docker build path; it does not enable project scans.
LUMINICENT_BUILD_NETWORK=none
# Generate each value independently with Node.js crypto.randomBytes(32).toString('base64url').
# Validation rejects malformed, placeholder, repeated, and obvious sequence values but cannot prove randomness.
LUMINICENT_API_TOKEN=
SESSION_SECRET=
SESSION_COOKIE_NAME=luminicent_session
SESSION_TTL_SECONDS=86400
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# Local development origins. Production proxy mode requires explicit HTTPS
# FRONTEND_URL, GITHUB_CALLBACK_URL, and matching CORS_ORIGIN values.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Persistent session and scan-record storage is required; startup fails if Redis
# is missing or unavailable. Use rediss:// for public production deployments.
# Docker Compose uses a named Redis data volume and AOF persistence for local use.
REDIS_URL=redis://localhost:6379

# GitHub OAuth credentials required for Sign in with GitHub
# Register an OAuth app at https://github.com/settings/developers
# - Homepage URL: http://localhost:5173
# - Authorization callback URL: http://localhost:5000/api/github/callback
# - Production callback: https://your-backend.example.com/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
GITHUB_REDIRECT_URI=http://localhost:5000/api/github/callback

# Trusted same-host TLS proxy example (set these together):
# HOST=127.0.0.1
# NODE_ENV=production
# LUMINICENT_TRUSTED_TLS_PROXY=true
# LUMINICENT_LOCAL_ONLY=false
# LUMINICENT_COMPOSE_LOCAL_ONLY=false
# SESSION_SECURE=true
# SESSION_SAME_SITE=none
# FRONTEND_URL=https://app.example.com
# CORS_ORIGIN=https://app.example.com
# GITHUB_CALLBACK_URL=https://api.example.com/api/github/callback
# GITHUB_REDIRECT_URI=https://api.example.com/api/github/callback
# Configure the GitHub OAuth app callback to exactly match GITHUB_CALLBACK_URL.
# Invalid or contradictory settings make the backend exit during startup.

# Optional: set to true if you want to force the callback URL from the server config.
STRICT_REDIRECT_URI=false
